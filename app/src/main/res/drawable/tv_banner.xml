<?xml version="1.0" encoding="utf-8"?>
<!-- The Android TV launcher's tile: the launcher icon's picture on its blue,
     in the 16:9 shape TV launchers ask for. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ic_launcher_background" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item
        android:width="180dp"
        android:height="180dp"
        android:drawable="@drawable/ic_launcher_foreground"
        android:gravity="center" />
</layer-list>
